# ============================================================
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN bagikan file .env ke siapa pun.
# ============================================================

# --- Claude API (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model default untuk semua agent
CLAUDE_MODEL=claude-opus-5

# --- Penyedia AI lain (opsional) ---
# Isi hanya yang ingin dipakai. Nama model harus persis seperti di akun Anda.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenRouter (openrouter.ai): satu API key untuk Claude, GPT, Gemini, DeepSeek, dll. Pakai API key biasa,
# BUKAN management key. Model per agent diatur di MODEL_<AGENT> (lihat daftar di openrouter.ai/models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.6-sol,google/gemini-3.5-flash

# AI untuk tiap agent: claude | openai | gemini | deepseek | openrouter
# Contoh: Developer (membuat script tracking) pakai Claude, QA (memeriksa & mengetes) pakai OpenAI.
# Jika memakai openrouter, model agent bisa dipilih di MODEL_<AGENT>, mis. MODEL_QA=openai/gpt-5.6-terra.
AI_HEAD_MARKETING=claude
AI_ADS_MANAGER=claude
AI_MEDIA_BUYER=claude
AI_ANALYST=claude
AI_TRACKING=claude
AI_CREATIVE=claude
AI_DEVELOPER=claude
AI_QA=openai
# Jika AI utama gagal (key kosong, saldo habis, error), dicoba AI berikutnya. Kosongkan = tanpa cadangan.
AI_FALLBACK=claude,openrouter,openai,gemini,deepseek
MODEL_HEAD_MARKETING=
MODEL_ADS_MANAGER=
MODEL_MEDIA_BUYER=
MODEL_ANALYST=
MODEL_TRACKING=
MODEL_CREATIVE=
MODEL_DEVELOPER=
MODEL_QA=

# --- Telegram ---
# ID grup (angka negatif, mis. -1001234567890). Kosongkan dulu, lalu ketik /id di grup untuk melihatnya.
TELEGRAM_GROUP_ID=
# ID Telegram Anda (Owner). Boleh lebih dari satu, pisahkan koma. Ketik /id di grup untuk melihatnya.
OWNER_TELEGRAM_IDS=

# Token bot tiap agent (dari @BotFather).
# Bot Head of Marketing WAJIB diisi: ia yang membaca grup, membuat topic, dan menerima tombol persetujuan.
# Agent yang tokennya kosong akan "menumpang" bicara lewat bot Head of Marketing.
BOT_TOKEN_HEAD_MARKETING=
BOT_TOKEN_ADS_MANAGER=
BOT_TOKEN_MEDIA_BUYER=
BOT_TOKEN_ANALYST=
BOT_TOKEN_TRACKING=
BOT_TOKEN_CREATIVE=
BOT_TOKEN_DEVELOPER=
BOT_TOKEN_QA=

TIMEZONE=Asia/Jakarta

# --- Dashboard web (buka di browser) ---
# 127.0.0.1 = hanya bisa dibuka dari komputer ini. Di VPS pakai 0.0.0.0 DAN wajib isi password.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8090
DASHBOARD_PASSWORD=

# --- Sumber data: demo | csv | bemob | rollerads ---
# demo  = data contoh (untuk uji coba sistem)
# csv   = baca file export laporan BeMob terbaru di folder data/inbox/
# bemob = tarik langsung dari BeMob API (isi bagian BeMob di bawah)
# rollerads = tarik langsung dari RollerAds API (isi bagian RollerAds di bawah)
DATA_SOURCE=demo

# Nama kolom pada CSV / JSON BeMob (sesuaikan dengan laporan Anda, per zone)
COL_CAMPAIGN=Campaign
COL_ZONE=Zone
COL_VISITS=Visits
COL_CONVERSIONS=Conversions
COL_COST=Cost
COL_REVENUE=Revenue

# --- BeMob API (lihat dokumentasi API di akun BeMob: Settings > Security / API) ---
# URL laporan; boleh memakai {date_from} dan {date_to} (format YYYY-MM-DD)
BEMOB_REPORT_URL=
BEMOB_AUTH_HEADER=Authorization
BEMOB_API_KEY=
# Kunci JSON yang berisi daftar baris laporan (mis. "rows"). Kosongkan jika respons langsung berupa list.
BEMOB_ROWS_KEY=rows

# --- BeMob REST API (Settings -> Security -> Create API Key, Read Only) ---
# Dipakai bersama RollerAds: pendapatan & konversi asli per campaign/zone, dan cek postback.
BEMOB_ACCESS_KEY=
BEMOB_SECRET_KEY=

# --- RollerAds API (token dari account manager RollerAds, diawali sk_api_) ---
# Campaign berstatus archived TIDAK PERNAH dibaca.
ROLLERADS_API_KEY=
# RollerAds hanya tahu biaya & konversi. Pendapatan = konversi x payout ini (USD). 0 = tidak dihitung.
ROLLERADS_PAYOUT_USD=0

# Bid maksimal untuk campaign baru yang dibuat dari panel atau agent (USD)
CAMPAIGN_MAX_BID_USD=5

# --- Auto-pause campaign RollerAds (dicek tanpa AI, gratis) ---
# 1 = aktif, 0 = mati. Hanya campaign berstatus active yang diperiksa; archived tidak pernah disentuh.
AUTOPAUSE_ENABLED=1
# Cek tiap X menit
AUTOPAUSE_MINUTES=15
# Hasil baru dinilai setelah spend campaign hari ini >= nilai ini (USD). Di bawahnya dianggap masih tes.
AUTOPAUSE_MIN_SPEND_USD=10
# Pause jika CPA (biaya per konversi) di atas nilai ini (USD). 0 = tidak dipakai.
AUTOPAUSE_MAX_CPA_USD=0
# Pause jika ROI di bawah nilai ini (%). Hanya dipakai jika ROLLERADS_PAYOUT_USD diisi.
AUTOPAUSE_MIN_ROI_PCT=-50
# Selain itu, campaign juga di-pause otomatis jika:
# - spend campaign hari ini >= MAX_CAMPAIGN_DAILY_BUDGET_USD (tidak wajar)
# - spend seluruh akun hari ini >= MAX_DAILY_SPEND_USD (semua campaign aktif di-pause)
# - spend >= AUTOPAUSE_MIN_SPEND_USD tanpa satu pun konversi (butuh postback BeMob -> RollerAds)

# --- Batas pengaman (guardrails) ---
# Batas total spend per hari (USD). Lewat dari ini -> alert darurat ke Owner.
MAX_DAILY_SPEND_USD=100
# Perubahan bid maksimal per usulan (%)
MAX_BID_CHANGE_PCT=25
# Budget harian maksimal per campaign yang boleh diusulkan AI (USD)
MAX_CAMPAIGN_DAILY_BUDGET_USD=50
# Zone dianggap boros jika spend >= nilai ini tanpa konversi (USD)
ZONE_WASTE_USD=3
# Zone dianggap rugi jika ROI di bawah nilai ini (%), dengan spend >= ZONE_WASTE_USD
ZONE_MIN_ROI_PCT=-50
# Zone dianggap bagus jika ROI >= nilai ini (%) dan konversi >= 2
ZONE_GOOD_ROI_PCT=30

# --- Script tracking website (dibuat Developer & dicek QA setiap campaign baru) ---
# URL postback BeMob (BeMob -> Settings -> Tracking domain), mis. https://xxxxx.bemobtrcks.com/postback
BEMOB_POSTBACK_URL=
# Nilai per pendaftaran (USD). 0 = dicatat tanpa nilai.
TRACK_REG_PAYOUT_USD=0
# Kurs 1 USD dalam rupiah, untuk mengubah nominal deposit ke USD
TRACK_KURS_USD=16000
# Porsi deposit yang dihitung pendapatan: 1 = seluruh deposit, 0.3 = 30%
TRACK_DEPOSIT_SHARE=1

# --- Pemeriksaan landing page & tracking (pisahkan koma) ---
LANDING_PAGE_URLS=https://gacortoto12.xyz/
TRACKING_URLS=

# --- Jadwal kerja ---
HEALTHCHECK_MINUTES=15
ANALYST_MINUTES=60
# Rapat tim otomatis (jam, pisahkan koma)
MEETING_TIMES=10:00,16:00,22:00
# Jeda minimal antar-rapat darurat (menit)
MEETING_MIN_GAP_MINUTES=120
DAILY_REPORT_TIME=08:00
QA_TIME=07:00
# Pengingat harian: "JAM|pesan;JAM|pesan"
DAILY_REMINDERS=09:00|Cek saldo RollerAds, top-up jika hampir habis;21:00|Review campaign hari ini sebelum tidur
# Tugas manual yang belum dikerjakan diingatkan ulang tiap X jam
TASK_REMIND_HOURS=3
